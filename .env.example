# Visiolog Environment Configuration Template
# Copy this file to .env.local and configure your environment variables.

# -----------------------------------------------------------------------------
# 1. Supabase Backend (Authentication, Storage, Realtime)
# Self-hosted Supabase or Supabase Cloud instance
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# 2. AI Extraction Engine (Google Gemini AI / BYOK)
# Get your API key at: https://aistudio.google.com/
# Multi-key pooling supported: separate keys with commas
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
# Optional fallback keys for high-volume load balancing
# GEMINI_API_KEY_POOL=key1,key2,key3

# -----------------------------------------------------------------------------
# 3. Privacy & Telemetry Settings
# By default, all tracking and telemetry are disabled for school data privacy
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PRIVACY_MODE=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# -----------------------------------------------------------------------------
# 4. Application Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
